<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.match</groupId>
        <artifactId>match-engine</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>match-loadtest</artifactId>
    <properties>
        <argLine></argLine>
        <!-- Overridden by the build with the short git sha. See the shade plugin's
             Build-Sha manifest entry for why this is never guessed. -->
        <buildSha>unknown</buildSha>
    </properties>
    <packaging>jar</packaging>
    <name>Match Load Test</name>
    <description>Load testing tools for the matching engine</description>

    <dependencies>
        <!-- Internal: common code -->
        <dependency>
            <groupId>com.match</groupId>
            <artifactId>match-common</artifactId>
        </dependency>

        <!-- Aeron for direct cluster communication -->
        <!-- Benchmark histograms: real p99.9/p99.99 without the periodic sort that the
             old ring-buffer tracker needed (that sort allocated 8MB and thrashed cache every
             report interval, perturbing the very tail it was measuring). -->
        <dependency>
            <groupId>org.hdrhistogram</groupId>
            <artifactId>HdrHistogram</artifactId>
            <version>2.2.2</version>
        </dependency>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-all</artifactId>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Create uber JAR for load testing -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>match-loadtest</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.match.loadtest.LoadGenerator</mainClass>
                                    <manifestEntries>
                                        <Add-Opens>java.base/jdk.internal.misc java.base/sun.nio.ch java.base/java.nio</Add-Opens>
                                        <!-- Stamped for the same reason the engine jar is: a
                                             published benchmark has to name the harness that
                                             produced its numbers, not only the engine under
                                             test. The default is the literal "unknown" rather
                                             than a guess, so a result set without provenance
                                             says so instead of implying it. -->
                                        <Build-Sha>${buildSha}</Build-Sha>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
