# /etc/openexchange/match/host.env: this host's memory and CPU knobs. Read by match-launch, not by the engine.
JAVA_HEAP=4g
# A taskset CPU list for the JVM; empty runs unpinned. Keep it off the driver's CPUs (aeronmd DRIVER_CPU_SET).
CPU_SET=
# More JVM flags, appended after the launcher's defaults (ZGC generational, NUMA, the Aeron add-opens).
JAVA_OPTS=-XX:+AlwaysPreTouch
