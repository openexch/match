# /etc/openexchange/match/member.env: the only file that differs between member hosts.
CLUSTER_NODE=0
# The node HTTP endpoint (/health, /ready, /metrics) is computed by the engine:
# CLUSTER_PORT_BASE + CLUSTER_NODE * CLUSTER_PORT_STRIDE + 6 (9006 at base 9000, stride 0).
# Optional explicit override: accepted only when it equals that number, any other value refuses the boot.
#METRICS_PORT=9006
