# /etc/openexchange/match/cluster.env: the same file on every member host.
# Every name here is read by match-cluster.jar; the engine refuses a malformed value at boot.

# The members' addresses in member-id order (host names or IPs, one per member).
CLUSTER_ADDRESSES=match-0.example.internal,match-1.example.internal,match-2.example.internal
# Ports: base + id * stride + offset (offsets 1..5 UDP: archive control, client, member, log, transfer; 6 the node
# HTTP endpoint /health, /ready, /metrics; 10 the ME journal archive control). Stride 0: one member per host, every
# host on the same ports.
CLUSTER_PORT_BASE=9000
CLUSTER_PORT_STRIDE=0

# The ME journal is the only path fills take to the core: on. Each member records it under SETTLEMENT_JOURNAL_DIR
# (the units default it to /var/lib/openexchange/match/journal) and serves its archive on base + id * stride + 10.
SETTLEMENT_JOURNAL_ENABLED=true
# The bridge and the market data reader replay the journal from another host: listen on every interface.
SETTLEMENT_JOURNAL_ARCHIVE_BIND=0.0.0.0
# The replicated EngineConfig record decides the engine shape.
MATCH_ENGINE_FROM_CONFIG=true

# Optional (engine defaults when unset):
#MATCH_ENGINE_BOOK_CAPACITY=
#TRANSPORT_IDLE_MODE=busy_spin
#TRANSPORT_DRIVER_THREADING=dedicated
#TRANSPORT_LOG_TERM_LENGTH=64m
#TRANSPORT_TERM_LENGTH=16m
#TRANSPORT_SNAPSHOT_TERM_LENGTH=8m
#TRANSPORT_CONSENSUS_TERM_LENGTH=1m
#TRANSPORT_JOURNAL_TERM_LENGTH=
#TRANSPORT_EXTERNAL_DRIVER_TIMEOUT_MS=30000
